{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/votrinhan88/jobspy-cli/schema/jobs.json",
  "title": "jobs.csv row",
  "description": "One row of jobs.csv. All values are text.",
  "type": "object",
  "required": [
    "job_id",
    "title",
    "company",
    "location"
  ],
  "properties": {
    "job_url": { "type": "string", "description": "Job URL from the board." },
    "title": { "type": "string", "description": "Job title." },
    "company": { "type": "string", "description": "Company name." },
    "location": { "type": "string", "description": "Raw location from the board." },
    "date_posted": { "type": "string", "description": "Date the board published the job." },
    "interval": { "type": "string", "description": "Salary interval." },
    "min_amount": { "type": "string", "description": "Minimum salary." },
    "max_amount": { "type": "string", "description": "Maximum salary." },
    "currency": { "type": "string", "description": "Salary currency." },
    "is_remote": { "type": "string", "description": "Remote flag from the board." },
    "id": { "type": "string", "description": "Board job id." },
    "site": { "type": "string", "description": "Board name." },
    "job_url_direct": { "type": "string", "description": "Direct employer URL." },
    "job_type": { "type": "string", "description": "Employment type from the board." },
    "salary_source": { "type": "string", "description": "Source of the salary data." },
    "job_level": { "type": "string", "description": "Seniority level from the board." },
    "job_function": { "type": "string", "description": "Job function from the board." },
    "listing_type": { "type": "string", "description": "Listing type from the board." },
    "emails": { "type": "string", "description": "Contact email text from the board." },
    "description": { "type": "string", "description": "Full job description." },
    "company_industry": { "type": "string", "description": "Company industry." },
    "company_url": { "type": "string", "description": "Company URL." },
    "company_num_employees": { "type": "string", "description": "Company employee count." },
    "company_revenue": { "type": "string", "description": "Company revenue." },
    "job_id": { "type": "string", "description": "Stable job identity. Never changes." },
    "status": { "type": "string", "description": "Application status from the web app." },
    "status_updated_at": { "type": "string", "description": "Time of the last status change." },
    "region": { "type": "string", "description": "State or province from the geocoder." },
    "role_key": { "type": "string", "description": "Hash of the normalized company and title." },
    "duplicate_of": { "type": "string", "description": "Canonical job id for a duplicate row." },
    "first_seen_at": { "type": "string", "description": "Time of the first sighting." },
    "last_seen_at": { "type": "string", "description": "Time of the most recent sighting." },
    "closed_at": { "type": "string", "description": "Time the URL probe found the job gone." },
    "closed_reason": { "type": "string", "description": "Close reason, for example url_404." },
    "country": { "type": "string", "description": "Country facet." },
    "city": { "type": "string", "description": "City facet." },
    "work_mode": { "type": "string", "description": "Remote, hybrid, onsite or empty." },
    "seniority": { "type": "string", "description": "Seniority facet." },
    "employment_type": { "type": "string", "description": "Employment type facet." }
  },
  "x-columns": [
    "job_url",
    "title",
    "company",
    "location",
    "date_posted",
    "interval",
    "min_amount",
    "max_amount",
    "currency",
    "is_remote",
    "id",
    "site",
    "job_url_direct",
    "job_type",
    "salary_source",
    "job_level",
    "job_function",
    "listing_type",
    "emails",
    "description",
    "company_industry",
    "company_url",
    "company_num_employees",
    "company_revenue",
    "job_id",
    "status",
    "status_updated_at",
    "region",
    "role_key",
    "duplicate_of",
    "first_seen_at",
    "last_seen_at",
    "closed_at",
    "closed_reason",
    "country",
    "city",
    "work_mode",
    "seniority",
    "employment_type"
  ],
  "additionalProperties": { "type": "string" }
}
